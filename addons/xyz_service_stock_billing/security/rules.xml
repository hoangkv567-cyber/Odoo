<odoo>
    <record id="account_task_rule" model="ir.rule"><field name="name">Accountants access service evidence</field><field name="model_id" ref="project.model_project_task"/><field name="groups" eval="[(4, ref('account.group_account_invoice'))]"/><field name="domain_force">[('xyz_booking_id', '!=', False)]</field><field name="perm_create">False</field><field name="perm_unlink">False</field></record>
    <record id="account_sale_rule" model="ir.rule"><field name="name">Accountants read sales evidence</field><field name="model_id" ref="sale.model_sale_order"/><field name="groups" eval="[(4, ref('account.group_account_invoice'))]"/><field name="domain_force">[(1, '=', 1)]</field><field name="perm_write">False</field><field name="perm_create">False</field><field name="perm_unlink">False</field></record>
    <record id="account_sale_line_rule" model="ir.rule"><field name="name">Accountants read sales line evidence</field><field name="model_id" ref="sale.model_sale_order_line"/><field name="groups" eval="[(4, ref('account.group_account_invoice'))]"/><field name="domain_force">[(1, '=', 1)]</field><field name="perm_write">False</field><field name="perm_create">False</field><field name="perm_unlink">False</field></record>
    <record id="material_boundary" model="ir.rule"><field name="name">Materials follow assigned jobs</field><field name="model_id" ref="model_xyz_material"/><field name="domain_force">[('company_id', 'in', company_ids)] if user.has_group('xyz_service_core.group_dispatcher') or user.has_group('account.group_account_invoice') else [('company_id', 'in', company_ids), ('task_id.user_ids', 'in', [user.id])]</field></record>
</odoo>
