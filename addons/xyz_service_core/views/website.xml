<odoo>
    <template id="xyz_brand" inherit_id="website.option_header_brand_logo"><xpath expr="//a" position="replace"><a href="/maintenance" class="navbar-brand fw-bold" style="color:#12344b;letter-spacing:2px">XYZ <small style="font-size:10px;letter-spacing:1px">INDUSTRIAL</small></a></xpath></template>
    <template id="xyz_footer" inherit_id="website.footer_custom"><xpath expr="//div[@id='footer']" position="replace"><div id="footer" class="oe_structure" t-if="not no_footer"><section class="py-5" style="background:#102b46;color:white"><div class="container"><div class="row gy-4"><div class="col-md-6"><h4>XYZ Industrial Services</h4><p>On-site compressor and cooling system maintenance.<br/>Transparent management from quotation to acceptance.</p></div><div class="col-md-3"><h5>Services</h5><a href="/maintenance" class="text-white">Book a maintenance visit</a><br/><a href="/my/maintenance" class="text-white">Maintenance history</a></div><div class="col-md-3"><h5>Contact</h5><p>service@xyz.example.test<br/>TP. Hồ Chí Minh</p><small>Educational project · Team 5</small></div></div></div></section></div></xpath></template>
    <template id="booking_page" name="XYZ Maintenance booking">
        <t t-call="website.layout"><div id="wrap" class="oe_structure">
            <section class="py-5" style="background:#102b46;color:white"><div class="container"><p class="text-uppercase">XYZ INDUSTRIAL SERVICES</p><h1>Proactive maintenance.<br/>Sustainable operations.</h1><p class="lead">Book equipment maintenance, receive a quotation and follow the service in one system.</p></div></section>
            <section class="container py-5"><div class="row gy-5 gx-lg-5"><div class="col-lg-5"><h2>On-site service</h2><p>Air compressors · Cooling systems · Safety inspection</p><p>The time you choose is a preference. A dispatcher confirms it after checking the technician and the materials.</p><div class="alert alert-info">Educational demo environment. No real payment is taken.</div></div>
            <div class="col-lg-7"><h2>Maintenance request</h2><div t-if="error" class="alert alert-danger">Please check the details and choose a time in the future.</div>
                <form action="/maintenance/book" method="post" class="row g-3">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="token" t-att-value="token"/>
                    <div class="col-md-6"><label class="form-label" for="name">Full name</label><input id="name" name="name" required="required" maxlength="200" class="form-control"/></div>
                    <div class="col-md-6"><label class="form-label" for="email">Email</label><input id="email" name="email" type="email" required="required" maxlength="200" class="form-control"/></div>
                    <div class="col-md-6"><label class="form-label" for="phone">Phone</label><input id="phone" name="phone" class="form-control" maxlength="40"/></div>
                    <div class="col-md-6"><label class="form-label" for="equipment">Equipment name or code</label><input id="equipment" name="equipment" required="required" class="form-control" maxlength="200"/></div>
                    <div class="col-12"><label class="form-label" for="address">Site address</label><input id="address" name="address" required="required" class="form-control" maxlength="500"/></div>
                    <div class="col-md-6"><label class="form-label" for="product_id">Service</label><select id="product_id" name="product_id" class="form-select" required="required"><t t-foreach="products" t-as="product"><option t-att-value="product.id"><t t-esc="product.name"/></option></t></select></div>
                    <div class="col-md-6"><label class="form-label" for="requested_start">Preferred time (Vietnam time)</label><input id="requested_start" name="requested_start" type="datetime-local" required="required" class="form-control"/></div>
                    <div class="col-12"><label class="form-label" for="description">Describe the issue</label><textarea id="description" name="description" rows="3" maxlength="2000" class="form-control"/></div>
                    <div class="col-12"><button class="btn btn-primary btn-lg" type="submit">Send the request and get a quotation</button></div>
                </form>
            </div></div></section>
        </div></t>
    </template>
    <template id="booking_thanks" name="Booking received"><t t-call="website.layout"><div id="wrap" class="container py-5"><h1>Maintenance request received</h1><p>The quotation is sent by email. A dispatcher confirms the schedule with you.</p><a href="/my/quotes" class="btn btn-primary">My quotations</a></div></t></template>
    <template id="portal_jobs" name="My service jobs"><t t-call="website.layout"><div id="wrap" class="container py-5"><h1>Maintenance history</h1><p t-if="not tasks">You have no maintenance jobs yet.</p><table t-if="tasks" class="table"><thead><tr><th>Job</th><th>Planned schedule</th><th>Status</th><th>Acceptance</th></tr></thead><tbody><tr t-foreach="tasks" t-as="task"><td t-esc="task.name"/><td><span t-field="task.xyz_start"/></td><td><span t-field="task.xyz_state"/></td><td><a t-foreach="task.xyz_acceptance_ids" t-as="acceptance" t-att-href="'/my/maintenance/%s/pdf' % acceptance.id" class="btn btn-outline-primary btn-sm">Download the acceptance record</a></td></tr></tbody></table></div></t></template>
</odoo>
