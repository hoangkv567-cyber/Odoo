<templates xml:space="preserve"><t t-name="xyz_service_core.Dispatch"><div class="xyz-dispatch p-4"><div class="d-flex flex-wrap justify-content-between mb-3"><div><h2>Maintenance dispatch</h2><p>Drag a job to change its time or technician. Double-click to open the job.</p></div><div><button class="btn btn-outline-primary me-2" t-on-click="day">Day</button><button class="btn btn-outline-primary me-2" t-on-click="week">Week</button><button class="btn btn-outline-primary me-2" t-on-click="today">Today</button><button class="btn btn-primary" t-on-click="load">Reload</button></div></div><div class="d-flex gap-3 mb-3"><select class="form-select w-auto" t-model="filters.area" t-on-change="load"><option value="">All areas</option><option t-foreach="filters.areas" t-as="area" t-key="area" t-att-value="area" t-esc="area"/></select><select class="form-select w-auto" t-model="filters.skill" t-on-change="load"><option value="">All skills</option><option t-foreach="filters.skills" t-as="skill" t-key="skill.id" t-att-value="skill.id" t-esc="skill.name"/></select></div><div t-ref="board"/></div></t></templates>
